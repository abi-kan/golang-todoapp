                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "User has been successfully changed",
                        "schema": {
                            "$ref": "#/definitions/github_com_abi-kan_golang-todoapp_internal_features_users_dto.PatchUserOutput"
